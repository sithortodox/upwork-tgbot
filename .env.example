# Telegram
BOT_TOKEN=your_telegram_bot_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/upwork_bot
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=upwork_bot

# Redis
REDIS_URL=redis://redis:6379/0

# Upwork API
UPWORK_CLIENT_ID=your_upwork_client_id
UPWORK_CLIENT_SECRET=your_upwork_client_secret

# Payment
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Service URLs (internal)
API_GATEWAY_URL=http://api-gateway:8000
PARSER_SERVICE_URL=http://parser-service:8001
AI_SERVICE_URL=http://ai-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003

# Proxy (optional)
DEFAULT_PROXY=

# Limits
FREE_DAILY_AI_LIMIT=5

# Encryption
ENCRYPTION_KEY=your-encryption-key-min-32-chars
